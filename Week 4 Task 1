import numpy as np

data = np.array([2, 4, 6, 8, 10])

# Mean
mean = np.mean(data)

# Median
median = np.median(data)

# Population variance
variance = np.var(data)

# Population standard deviation
std = np.std(data)

print("Mean:", mean)
print("Median:", median)
print("Variance:", variance)
print("Standard Deviation:", std)
