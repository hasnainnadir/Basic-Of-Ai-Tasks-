# Practice Pandas
# Load, Filter, Group By, Handle Missing Values
# ============================================

import pandas as pd

# -------------------------
# Create a sample dataset
# -------------------------
data = {
    "Name": ["Ali", "Sara", "Ahmed", "Ayesha", "Bilal"],
    "Department": ["IT", "HR", "IT", "Finance", "HR"],
    "Salary": [50000, 45000, None, 60000, 40000],
    "Age": [25, 30, 28, None, 26]
}

df = pd.DataFrame(data)

print("Original Dataset:")
print(df)

# -------------------------
# Handle Missing Values
# -------------------------

# Fill missing Salary with 0
df["Salary"] = df["Salary"].fillna(0)

# Fill missing Age with the average age
df["Age"] = df["Age"].fillna(df["Age"].mean())

print("\nDataset After Handling Missing Values:")
print(df)

# -------------------------
# Filter Rows
# -------------------------

# Employees with Salary greater than 45000
filtered = df[df["Salary"] > 45000]

print("\nEmployees with Salary > 45000:")
print(filtered)

# -------------------------
# Group By Department
# -------------------------

grouped = df.groupby("Department")["Salary"].mean()

print("\nAverage Salary by Department:")
print(grouped)
