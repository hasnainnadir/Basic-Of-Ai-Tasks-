# Simple Linear Regression from Scratch
# Using Manual Gradient Descent

import numpy as np

# Training data
X = np.array([1, 2, 3, 4, 5], dtype=float)
y = np.array([2, 4, 6, 8, 10], dtype=float)

# Initial values
m = 0.0       # slope
b = 0.0       # intercept

# Learning rate
learning_rate = 0.01

# Number of iterations
epochs = 1000

# Number of data points
n = len(X)

# Gradient Descent
for i in range(epochs):

    # Prediction: y = mx + b
    y_pred = m * X + b

    # Calculate error
    error = y_pred - y

    # Calculate gradients
    dm = (2 / n) * np.sum(X * error)
    db = (2 / n) * np.sum(error)

    # Update m and b
    m = m - learning_rate * dm
    b = b - learning_rate * db

# Final model
print("Slope (m):", m)
print("Intercept (b):", b)

# Predictions
predictions = m * X + b

print("\nActual values:", y)
print("Predicted values:", predictions)

# Predict a new value
x_new = 6
y_new = m * x_new + b

print("\nPrediction for x =", x_new, ":", y_new)
