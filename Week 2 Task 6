# ============================
# Git Practice - All Commands
# ============================

# 1. Create a project folder
mkdir git-practice
cd git-practice

# 2. Initialize Git
git init

# 3. Create a README file
echo "# Git Practice" > README.md

# 4. Add the file
git add README.md

# 5. Make the first commit
git commit -m "Initial commit"

# 6. Rename the default branch to main
git branch -M main

# 7. Connect your GitHub repository
# Replace <username> with your GitHub username
git remote add origin https://github.com/<username>/git-practice.git

# 8. Push the main branch to GitHub
git push -u origin main

# 9. Create and switch to a new branch
git checkout -b feature-update

# 10. Make changes to the README
echo "This is my Git practice project." >> README.md

# 11. Add the updated file
git add README.md

# 12. Commit the changes
git commit -m "Update README with project description"

# 13. Push the new branch
git push -u origin feature-update

